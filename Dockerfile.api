# Slim FastAPI job server for browser_use.
# Remote CDP only: this image does NOT bundle Chromium / does not run
# `playwright install`. The agent attaches to a remote Chrome over CDP
# (CHROME_CDP_URL), so the image stays small.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Copy the whole repo (the package source is needed for `pip install -e .`).
COPY . /app

# Install the browser_use package plus the HTTP server deps.
# No browser binaries are installed (remote CDP only).
RUN pip install -e . && \
    pip install "fastapi" "uvicorn[standard]"

EXPOSE 8000

# run.py binds a DUAL-STACK :: socket (IPV6_V6ONLY=0) so the server answers both
# Railway's IPv6 private network (siblings via *.railway.internal) AND Railway's
# IPv4 deploy healthcheck. Plain `uvicorn --host ::` is IPv6-only (asyncio forces
# IPV6_V6ONLY=1) and makes the healthcheck fail. See run.py for the full rationale.
CMD ["python", "run.py"]
